<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Same lists as backup_rules.xml; see the comment there. Device-to-device transfer
     uses the same rules as cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="gym.db" />
        <include domain="sharedpref" path="gymsupreme.counters.xml" />
        <exclude domain="file" path="journal/" />
        <exclude domain="file" path="export/" />
        <exclude domain="file" path="spike/" />
        <exclude domain="file" path="ble-trail.log" />
        <exclude domain="file" path="install_marker.txt" />
        <exclude domain="file" path="gym.db-wal" />
        <exclude domain="file" path="gym.db-shm" />
        <exclude domain="sharedpref" path="gymsupreme.journal.xml" />
        <exclude domain="sharedpref" path="gymsupreme.ble.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="gym.db" />
        <include domain="sharedpref" path="gymsupreme.counters.xml" />
        <exclude domain="file" path="journal/" />
        <exclude domain="file" path="export/" />
        <exclude domain="file" path="spike/" />
        <exclude domain="file" path="ble-trail.log" />
        <exclude domain="file" path="install_marker.txt" />
        <exclude domain="file" path="gym.db-wal" />
        <exclude domain="file" path="gym.db-shm" />
        <exclude domain="sharedpref" path="gymsupreme.journal.xml" />
        <exclude domain="sharedpref" path="gymsupreme.ble.xml" />
    </device-transfer>
</data-extraction-rules>
