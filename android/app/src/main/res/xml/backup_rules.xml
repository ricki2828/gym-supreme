<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup, API 29-30 (plan 7, B6). The database (files/gym.db) and the native gate
     counters are backed up; the live journal, exports, spike evidence, device-specific strap
     state and the install marker are not (the marker must never be restored, or install-over
     checks read fresh=false). gym.db-wal is backed up too (a backup between checkpoints would
     otherwise miss the last writes; SQLite ignores a stale WAL by salt); -shm is not. The app
     checkpoints on pause, after a finish and before export. Same lists as data_extraction_rules.xml (API 31+). -->
<full-backup-content>
    <include domain="file" path="gym.db" />
    <include domain="sharedpref" path="gymsupreme.counters.xml" />
    <exclude domain="file" path="journal/" />
    <exclude domain="file" path="export/" />
    <exclude domain="file" path="spike/" />
    <exclude domain="file" path="ble-trail.log" />
    <exclude domain="file" path="install_marker.txt" />
    <!-- WAL kept: a backup between checkpoints would miss the last writes; SQLite ignores a stale WAL (salt). -->
    <include domain="file" path="gym.db-wal" />
    <exclude domain="file" path="gym.db-shm" />
    <exclude domain="sharedpref" path="gymsupreme.journal.xml" />
    <exclude domain="sharedpref" path="gymsupreme.ble.xml" />
</full-backup-content>
